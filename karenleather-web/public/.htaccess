Options -MultiViews
RewriteEngine On

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → دامنه اصلی
RewriteCond %{HTTP_HOST} ^www\.karenleather\.com [NC]
RewriteRule ^ https://karenleather.com%{REQUEST_URI} [L,R=301]

# نقشه سایت XML از PHP — فایل استاتیک .xml روی بعضی هاست‌ها ۵۰۰ می‌شود
RewriteRule ^(sitemap\.xml|wp-sitemap\.xml)$ sitemap.php [L]

# robots، اشتراک، نقشه HTML و ورودی SPA را بازنویسی نکن
RewriteRule ^(robots\.txt|share\.php|share-pages\.json|sitemap\.html|sitemap\.php|spa\.php)$ - [L]

# فایل‌های استاتیک را هرگز به SPA نفرست
RewriteRule ^uploads/ - [L]
RewriteRule ^assets/ - [L]

# خزنده شبکه‌های اجتماعی — تصویر شاخص و عنوان واقعی همان URL
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Pinterest|Discordbot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare|meta-externalagent|meta-externalfetcher|QQBot|MicroMessenger) [NC]
RewriteRule ^ share.php [L]

# فایل/پوشه موجود را مستقیم سرو کن
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA: مسیر شناخته‌شده ۲۰۰، بقیه ۴۰۴ واقعی
RewriteRule ^ spa.php [L]
